# Supabase CLI environment variables for non-interactive automation (Claude sessions,
# CI, scripts). Copy this file to `.env` in the repo root and fill in real values there.
# `.env` is gitignored and must never be committed.

# Personal access token, used so `supabase` commands don't need an interactive login.
# Get one (or create a new one) at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# The linked project's database password, used so commands like `migration list` and
# `migration repair` don't prompt for it. Find it, or reset it, on the project's
# Database settings page: https://supabase.com/dashboard/project/yvmxyynxpheudnyoveqx/settings/database
SUPABASE_DB_PASSWORD=
