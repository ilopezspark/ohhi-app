# Copy to .env (gitignored, never committed) and fill in real values.
# Both are read at build/config time via app.config.ts's `extra` — see
# ../docs/app-architecture-plan.md §8. These are the anon/publishable key and
# project URL only — NEVER the service role key or any other secret.

EXPO_PUBLIC_SUPABASE_URL=https://yvmxyynxpheudnyoveqx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Must match Authentication -> Providers -> Email -> OTP length on the hosted
# Supabase project. Clamped client-side to Supabase's own 6-10 range
# (src/auth/otpLength.ts); defaults to 6 if unset.
EXPO_PUBLIC_OTP_LENGTH=6
